# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# local env files — NEVER commit real keys
.env
.env.local
.env*.local

# local dev data store
/.data

# paste-into-Vercel helper (contains real keys)
vercel-env.txt

# added by `vercel link` — the CLI writes a project id and an OIDC token here
.vercel
.env*
# ...but the blank template with the explanations must stay in the repo.
!.env.local.example

# Capacitor native projects. Generated by `npx cap add` and rebuilt by `cap sync`,
# so they are reproducible, but the iOS build also drops Pods and user-specific
# Xcode state in here that must not be committed.
/ios/App/Pods
/ios/App/App.xcworkspace/xcuserdata
/ios/App/App.xcodeproj/xcuserdata
/android/.gradle
/android/app/build
/android/build
/android/local.properties
