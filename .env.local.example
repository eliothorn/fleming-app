# ─────────────────────────────────────────────────────────────────────────────
# Fleming Realty app — environment configuration
#
# Copy this file to `.env.local` and fill in the values to switch from the
# built-in DEV MODE (mock auth + mock Buildium data) to the real services.
#
# The app runs fully WITHOUT any of these set — it falls back to dev mocks so
# you can build and demo immediately. Add keys as they become available.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (real authentication + user/role database) ──────────────────────
# Create a free project at https://supabase.com → Project Settings → API.
# When BOTH of these are set, the app uses real Supabase Auth instead of dev auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is SERVER-ONLY (never prefixed NEXT_PUBLIC). Used by API routes
# to read a user's role/profile. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── Buildium Open API (real property-management data) ────────────────────────
# Generated in Buildium → Settings → Developer Tools → API Keys (Premium plan).
# When BOTH are set, /api/buildium/* calls the real Buildium API instead of mocks.
BUILDIUM_CLIENT_ID=
BUILDIUM_CLIENT_SECRET=

# Which Buildium account this points at. THE most consequential line in this file.
#   https://api.buildium.com/v1            the broker's real account
#   https://apisandbox.buildium.com/v1     an isolated copy, free with Premium
# The sandbox holds realistic sample data, uses its own separate API keys, and —
# critically — Buildium sends no email from it, so a test cannot reach a real
# resident or contractor. Create one in Buildium → Settings → Developer Tools →
# API Sandbox. Test every write there first; /api/deploy-check reports which of
# the two a deployment is talking to.
BUILDIUM_BASE_URL=https://api.buildium.com/v1

# ── Buildium writes: two switches, because the blast radius differs ───────────
# Reads are safe; writes are not undoable. Both default OFF, and the UI tells the
# truth about whichever state it is in rather than claiming more than it did.
#
# BUILDIUM_WRITES — creating and updating tickets. Stays between the office and
# the resident. Verify with `node scripts/write-payloads.mjs`, which asserts the
# exact payloads against live records WITHOUT sending any of them.
BUILDIUM_WRITES=

# BUILDIUM_WRITE_WORKORDERS — assigning a contractor. Raises a real work order,
# which is the only write Buildium can email someone OUTSIDE the office about.
# Requires BUILDIUM_WRITES as well. Until this is on, the Assign screen says the
# assignment was recorded here and emailed but not written into Buildium.
BUILDIUM_WRITE_WORKORDERS=

# ── App ──────────────────────────────────────────────────────────────────────
# Secret used to sign the dev-mode session cookie. Any random string is fine.
AUTH_COOKIE_SECRET=dev-only-change-me

# Local demos only. Allows the seeded @fleming.test accounts to sign in.
# Leave UNSET in production — they share one published password and carry
# employee/owner roles, so enabling them on a public URL exposes real data.
ALLOW_DEMO_ACCOUNTS=
